# SQLite 파일 DB 경로 (SQLAlchemy URL 형식)
DATABASE_URL=sqlite:///./travel_planner.db

# 세션 쿠키 서명에 사용하는 비밀키. 운영 환경에서는 반드시 무작위 긴 문자열로 교체할 것.
SECRET_KEY=change-this-to-a-long-random-secret-key

# 세션 쿠키 만료 시간(초). 기본 7일.
SESSION_MAX_AGE_SECONDS=604800

# 초대 링크 만료 기간(시간). 기본 7일(168시간).
INVITATION_EXPIRE_HOURS=168

# 비밀번호 재설정 링크 만료 기간(분). 기본 30분.
PASSWORD_RESET_EXPIRE_MINUTES=30

# 초대 수락 링크를 만들 때 사용할 프론트엔드 베이스 URL
APP_BASE_URL=http://127.0.0.1:8000

# ==================================================
# 이메일(SMTP) 발송 설정
# ==================================================

# 실제 이메일 발송 기능 사용 여부
# 개발 중에는 false, SMTP 설정과 테스트가 끝나면 true로 변경
EMAIL_ENABLED=false

# SMTP 서버 정보
# Gmail 예시: smtp.gmail.com / 587 / TLS 사용
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com

# 절대로 Git에 올리지 말 것.
# Gmail 사용 시 일반 비밀번호가 아니라 앱 비밀번호를 사용
SMTP_PASSWORD=replace-with-app-password

# 메일을 보낼 때 표시되는 발신자 정보
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=Travel Planner

# SMTP 서버 연결 후 TLS 암호화 적용 여부
SMTP_USE_TLS=true

# ==================================================
# 장소 검색 API
# ==================================================

# Google Places API (New): 해외 장소 검색
GOOGLE_MAPS_API_KEY=

# Maps JavaScript API: 브라우저 지도 마커 표시 전용 키
# HTTP referrer 제한 및 Maps JavaScript API 제한을 반드시 적용
GOOGLE_MAPS_BROWSER_API_KEY=

# Kakao Local API: 국내 장소 검색
KAKAO_REST_API_KEY=

# Kakao Maps JavaScript SDK: 국내 여행 브라우저 지도 표시 전용 키 (Kakao Developers > 앱 키 > JavaScript 키)
KAKAO_JAVASCRIPT_KEY=

# Gemini API: 예약 스크린샷 분석(백엔드 1단계)
GEMINI_API_KEY=
